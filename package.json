{
  "name": "MMM-BSR-Trash-Calendar",
  "version": "1.0.0",
  "description": "MagicMirror² module to display BSR/ALBA trash collection dates for a configured Berlin address",
  "main": "MMM-BSR-Trash-Calendar.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:integration": "vitest run tests/integration",
    "prepare": "husky install"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "commitlint": "^21.2.2",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
